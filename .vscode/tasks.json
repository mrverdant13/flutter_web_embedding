{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Angular Web App",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/ng-flutter",
      },
      "type": "npm",
      "script": "build",
      "presentation": {
        "close": true,
        "reveal": "always",
        "panel": "dedicated",
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1,
        "reevaluateOnRerun": true,
      },
    },
    {
      "label": "Serve Angular Web App",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/ng-flutter",
      },
      "type": "npm",
      "script": "start",
      "dependsOn": [
        "Build Angular Web App",
      ],
      "presentation": {
        "close": true,
        "reveal": "always",
        "panel": "dedicated",
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1,
        "reevaluateOnRerun": true,
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "Compiled successfully.",
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Compiled successfully.",
        },
      },
    },
    {
      "label": "Kill Angular Server",
      "command": "echo '${input:terminate}' || echo 0",
      "type": "shell",
      "presentation": {
        "reveal": "silent",
        "close": true,
        "echo": false,
      },
      "hide": true,
    },
  ],
  "inputs": [
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "Serve Angular Web App",
    },
  ],
}
