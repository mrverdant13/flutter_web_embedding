{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Element Embedding Demo (Flutter)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/element_embedding_demo/",
      "toolArgs": [
        "--no-pub",
        "--web-port=3000",
      ],
      "program": "lib/main.dart",
    },
    {
      "name": "Multi-View Flutter Web Embedding (Angular)",
      "request": "launch",
      "type": "chrome",
      "preLaunchTask": "Serve Angular Web App",
      "postDebugTask": "Kill Angular Server",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/ng-flutter",
      // "runtimeArgs": [
      //   "--disable-web-security",
      // ],
      "userDataDir": "/tmp/chrome_dev",
    },
  ],
}
